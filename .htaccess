# ORNAPLANT — Apache rewrites para SEO

RewriteEngine On

# 301: /index.html → / (consolidar link equity, evitar duplicado)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# No tocar /api/ (deja pasar tal cual)
RewriteRule ^api/ - [L]

# /sitemap.xml → sitemap.php (Google espera .xml)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# URL bonita: /catalogo/{slug} → planta.php?slug={slug}
RewriteRule ^catalogo/([^/.]+)/?$ planta.php?slug=$1 [QSA,L]

# URL bonita: /planta/{slug} → planta.php?id={slug}
RewriteRule ^planta/([^/]+)/?$ planta.php?id=$1 [QSA,L]

# Redirect 301: planta.html?id=X → /planta/X (preserva links viejos)
RewriteCond %{THE_REQUEST} \s/+planta\.html\?id=([^\s&]+) [NC]
RewriteRule ^planta\.html$ /planta/%1? [R=301,L]

# Bloquear acceso a .env y archivos sensibles
<FilesMatch "^\.env|^\.htaccess|\.sql$">
  Require all denied
</FilesMatch>

# Cachear assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Compresión gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml
</IfModule>
